{
  "expo": {
    "name": "LocalLLMBenchmark",
    "slug": "local-llm-benchmark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "android": {
      "package": "com.localllm.benchmark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": true,
          "enableVulkan": true
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow EdgeAnalyzer to access your device location for live weather and contextual tools.",
          "locationWhenInUsePermission": "Allow EdgeAnalyzer to access your device location for live weather and contextual tools."
        }
      ],
      "expo-secure-store"
    ]
  }
}
